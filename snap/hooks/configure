#!/bin/sh
set -eu

. "$SNAP/bin/mailpit-env"

for listener in smtp http pop3; do
  key="$listener-address"
  value="$(snapctl get "$key")"
  if [ -z "$value" ]; then
    value="$(default_address "$listener")"
    snapctl set "$key=$value"
  fi
  case "$value" in
    *[![:print:]]*)
      echo "$key must not contain control characters" >&2
      exit 1
      ;;
  esac
  if ! printf '%s\n' "$value" | grep -Eq '^([A-Za-z0-9][A-Za-z0-9.-]*|\[[0-9A-Fa-f:.]+\]):[0-9]{1,5}$'; then
    echo "$key must be host:port or [IPv6]:port" >&2
    exit 1
  fi
  port="${value##*:}"
  if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
    echo "$key port must be between 1 and 65535" >&2
    exit 1
  fi
done

smtp="$(snapctl get smtp-address)"
http="$(snapctl get http-address)"
pop3="$(snapctl get pop3-address)"
if [ "$smtp" = "$http" ] || [ "$smtp" = "$pop3" ] || [ "$http" = "$pop3" ]; then
  echo "smtp-address, http-address and pop3-address must differ" >&2
  exit 1
fi

if snapctl services "$SNAP_INSTANCE_NAME.daemon" | grep -qwE 'enabled|active'; then
  snapctl restart "$SNAP_INSTANCE_NAME.daemon"
fi
