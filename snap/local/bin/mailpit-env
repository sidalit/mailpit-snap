# Sourced by the mailpit launchers and the configure hook.

# Listeners stay on this machine unless `snap set mailpit ...` says otherwise.
default_address() {
  case "$1" in
    smtp) echo 127.0.0.1:1025 ;;
    http) echo 127.0.0.1:8025 ;;
    pop3) echo 127.0.0.1:1110 ;;
  esac
}

# The address of a listener: its snap option, or the default when unset.
address() {
  value="$(snapctl get "$1-address" 2>/dev/null || true)"
  echo "${value:-$(default_address "$1")}"
}
